# Service configuration — shared by bonsai.sh and bonsai-service.sh.
#
# Copy to `bonsai.env` (git-ignored) and edit. Both the interactive
# `./bonsai.sh` commands and the launchd service read it, so they always agree
# on which address and port to use. Anything set in the environment wins over
# this file.
#
#   cp bonsai.env.example bonsai.env
#
# There is no authentication on the server or the bridge. The bind address is
# the access control: leave it on loopback unless you understand what you are
# exposing.

# Bind address for the API server and the Ollama bridge. Defaults to 127.0.0.1.
# Loopback is always served too: openai_proxy.py binds this address *and*
# 127.0.0.1, so localhost keeps working when you expose a VPN address.
# To serve your own devices over a VPN (e.g. Tailscale), set the VPN address:
#   BONSAI_HOST="$(tailscale ip -4)"
BONSAI_HOST=127.0.0.1

# Ports. PORT belongs to the OpenAI proxy (openai_proxy.py); the Splash engine
# binds loopback on PORT + 1 and is never reachable from the network. Override
# BONSAI_ENGINE_PORT only if PORT + 1 is already taken on this machine.
PORT=8080
BRIDGE_PORT=11434
# BONSAI_ENGINE_PORT=8081

# Embeddings (optional). /v1/embeddings is served by a small MLX EmbeddingGemma
# service (embeddings_service.py, loopback on BONSAI_EMBED_PORT) — the Splash
# engine has no pooling head. Requires mlx-vlm in .venv; set BONSAI_EMBED=0 to
# turn the route into a clear 501.
# BONSAI_EMBED=1
# BONSAI_EMBED_MODEL=gahabeen/embeddinggemma-2-text-270m-mlx-bf16
# BONSAI_EMBED_PORT=8082
# BONSAI_EMBED_DIM=768
# BONSAI_EMBED_MAX_TOKENS=8192

# Context window for the service. 8192-262144. Leave unset to use the value in
# .bonsai-ctx (which the chat page's context slider writes), else 65536.
# BONSAI_CTX=65536

# Model repo served, OWNER/REPO[:VARIANT]. The default is Bonsai 2 27B at the
# PQ2_0 band; Splash fetches it (plus its DFlash2 draft and vision projector)
# into its own cache on first run.
# BONSAI_SPLASH_MODEL=prism-ml/Ternary-Bonsai-2-27B-gguf:PQ2_0

# Free model memory after this much idle time: off (stay loaded), or a Splash
# duration such as 30s / 10m. On a 24 GB machine `10m` returns ~11 GB while
# idle, at the cost of a few seconds on the next request after a long pause.
# BONSAI_IDLE_RELEASE=off

# Restart-proof prefix cache (optional, SSD writes). Keeps cached conversation
# prefixes across restarts — e.g. the restart that a context-slider change
# triggers. Measured: 6.4K prompt replayed in 0.6 s after restart vs 20.2 s
# fresh. Needs BONSAI_MAX_CACHE_DISK; without it the flag is skipped with a
# warning. Leave off unless restarts currently wipe your agent prefixes.
# BONSAI_MAX_CACHE_DISK=16G
# BONSAI_PERSISTENT_CACHE=0

# Default thinking level for requests that omit reasoning_effort:
# none|minimal|low|medium|high|xhigh|max. Per-request reasoning_effort still
# wins. `medium` is the model card's recommended speed/accuracy balance; `none`
# is fastest for retrieval/reformat turns. Avoid `low`: upstream documents it as
# unsupported, behaving close to `xhigh` (near-maximum thinking on every call).
# BONSAI_REASONING_EFFORT=medium

# Thinking level the proxy applies to requests that carry a `tools` array and
# set no reasoning_effort of their own (none|low|...|max, or `off` to disable).
# Thinking is spent from the same max_tokens as the answer, so inheriting `low`
# made agent turns return content "" with finish_reason "length" whenever a
# client capped output near 1K. Set `low` only if your harness uses
# max_tokens >= 8192.
# BONSAI_AGENT_EFFORT=none
